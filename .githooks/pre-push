#!/bin/sh
# Last line of defence: scan every commit about to be pushed, including ones
# made before the hooks existed or with --no-verify.
. "$(dirname "$0")/check-email.sh"

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote ref
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"   # new branch/tag: everything not already on a remote
  else
    range="$remote_sha..$local_sha"
  fi
  bad=$(git log --format='%h %ae %ce' $range | while read -r h ae ce; do
    is_allowed "$ae" && is_allowed "$ce" || echo "  $h author=<$ae> committer=<$ce>"
  done)
  if [ -n "$bad" ]; then
    echo "pre-push: refusing to push $local_ref, commits expose a real email:" >&2
    echo "$bad" >&2
    status=1
  fi
done
exit $status
