{
  "manifest_version": 3,
  "name": "Subtitle Restyler",
  "version": "0.1.0",
  "description": "Restyle subtitles on Netflix, Disney+ and Prime Video.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.disneyplus.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Subtitle Restyler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*"
      ],
      "js": ["src/defaults.js", "src/platforms.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
